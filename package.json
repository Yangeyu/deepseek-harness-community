{
  "name": "@vascent/dsh-tui",
  "version": "0.1.23",
  "description": "One-command DeepSeek Harness TUI launcher and community extension workspace",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "tui",
    "coding-agent",
    "terminal"
  ],
  "homepage": "https://github.com/Yangeyu/deepseek-harness-community#readme",
  "bugs": {
    "url": "https://github.com/Yangeyu/deepseek-harness-community/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yangeyu/deepseek-harness-community.git"
  },
  "type": "module",
  "bin": {
    "dscode": "bin/dscode.js"
  },
  "exports": {
    ".": {
      "types": "./packages/tui/dist/index.d.ts",
      "default": "./packages/tui/dist/index.js"
    },
    "./memory": {
      "types": "./packages/tui/dist/memory.d.ts",
      "default": "./packages/tui/dist/memory.js"
    },
    "./bailian": {
      "types": "./packages/tui/dist/bailian.d.ts",
      "default": "./packages/tui/dist/bailian.js"
    },
    "./vision": {
      "types": "./packages/tui/dist/vision.d.ts",
      "default": "./packages/tui/dist/vision.js"
    },
    "./web": {
      "types": "./packages/tui/dist/web.d.ts",
      "default": "./packages/tui/dist/web.js"
    },
    "./cordis.patch.yml": "./packages/tui/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/dscode.js",
    "dist/launcher.js",
    "examples/settings.yaml.example",
    "examples/cordis.patch.yml.example",
    "guides/AGENTS.md",
    "guides/docs/configuration.md",
    "guides/docs/troubleshooting.md",
    "packages/tui/cordis.patch.yml",
    "packages/tui/dist/*.d.ts",
    "packages/tui/dist/*.js",
    "packages/tui/package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @vascent/deepseek-harness-tui... run build && tsdown",
    "lint": "oxlint --deny-warnings src scripts tests tsdown.config.ts && pnpm --filter './packages/*' run lint",
    "typecheck": "tsc --noEmit && pnpm --filter './packages/*' run typecheck",
    "test": "vitest run tests/launcher.test.ts tests/release.test.ts && pnpm --filter './packages/*' run test",
    "check": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev": "pnpm run build && node bin/dscode-dev.js",
    "release": "release-it",
    "release:check": "node scripts/release-gate.mjs",
    "start": "node bin/dscode.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "catalog:dsh",
    "@deepseek-ai/dsh-anonymous-user-id": "catalog:dsh",
    "@deepseek-ai/dsh-attachment": "catalog:dsh",
    "@deepseek-ai/dsh-attachment-local": "catalog:dsh",
    "@deepseek-ai/dsh-authorization": "catalog:dsh",
    "@deepseek-ai/dsh-bash-local": "catalog:dsh",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "catalog:dsh",
    "@deepseek-ai/dsh-cordis-host-runner": "catalog:dsh",
    "@deepseek-ai/dsh-credentials": "catalog:dsh",
    "@deepseek-ai/dsh-fs": "catalog:dsh",
    "@deepseek-ai/dsh-home-paths": "catalog:dsh",
    "@deepseek-ai/dsh-host-apiproxy": "catalog:dsh",
    "@deepseek-ai/dsh-host-directory-picker-browse": "catalog:dsh",
    "@deepseek-ai/dsh-launch-environment": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-permission-presets": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection-cache": "catalog:dsh",
    "@deepseek-ai/dsh-session-stats": "catalog:dsh",
    "@deepseek-ai/dsh-session-telemetry": "catalog:dsh",
    "@deepseek-ai/dsh-session-title-llm": "catalog:dsh",
    "@deepseek-ai/dsh-settings": "catalog:dsh",
    "@deepseek-ai/dsh-storage": "catalog:dsh",
    "@deepseek-ai/dsh-storage-domain": "catalog:dsh",
    "@deepseek-ai/dsh-storage-json": "catalog:dsh",
    "@deepseek-ai/dsh-subagent-in-process-driver": "catalog:dsh",
    "@deepseek-ai/dsh-system-prompt": "catalog:dsh",
    "@deepseek-ai/dsh-timeout": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/dsh-web": "catalog:dsh",
    "@deepseek-ai/dsh-web-search-deepseek": "catalog:dsh",
    "@deepseek-ai/dsh-workspace": "catalog:dsh",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-tui": "^0.84.2",
    "@vscode/ripgrep": "^1.18.0",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "pnpm": "11.7.0",
    "yaml": "^2.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "npm": "11.19.0",
    "oxlint": "1.76.0",
    "release-it": "21.0.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
