{
  "name": "@vascent/dsh-tui",
  "version": "0.1.16",
  "description": "One-command DeepSeek Harness TUI launcher and community extension workspace",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "tui",
    "coding-agent",
    "terminal"
  ],
  "homepage": "https://github.com/Yangeyu/deepseek-harness-community#readme",
  "bugs": {
    "url": "https://github.com/Yangeyu/deepseek-harness-community/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yangeyu/deepseek-harness-community.git"
  },
  "type": "module",
  "bin": {
    "dscode": "bin/dscode.js"
  },
  "exports": {
    ".": {
      "types": "./packages/tui/dist/index.d.ts",
      "default": "./packages/tui/dist/index.js"
    },
    "./tui": {
      "types": "./packages/tui/dist/index.d.ts",
      "default": "./packages/tui/dist/index.js"
    },
    "./memory": {
      "types": "./packages/tui/dist/memory.d.ts",
      "default": "./packages/tui/dist/memory.js"
    },
    "./bailian": {
      "types": "./packages/tui/dist/bailian.d.ts",
      "default": "./packages/tui/dist/bailian.js"
    },
    "./vision": {
      "types": "./packages/tui/dist/vision.d.ts",
      "default": "./packages/tui/dist/vision.js"
    },
    "./web": {
      "types": "./packages/tui/dist/web.d.ts",
      "default": "./packages/tui/dist/web.js"
    },
    "./cordis.patch.yml": "./packages/tui/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/dscode.js",
    "dist/launcher.js",
    "dist/launcher.js.map",
    "packages/tui/CHANGELOG.md",
    "packages/tui/cordis.patch.yml",
    "packages/tui/dist",
    "packages/tui/LICENSE",
    "packages/tui/package.json",
    "packages/tui/README.md",
    "docs/tui-architecture.md",
    "docs/tui-product-roadmap.md",
    "docs/tui-v0.1.6-design.md",
    "docs/tui-v0.1.7-design.md",
    "docs/tui-v0.1.8-design.md",
    "docs/tui-v0.1.9-design.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @vascent/deepseek-harness-memory run build && pnpm --filter @vascent/deepseek-harness-llm-bailian run build && pnpm --filter @vascent/deepseek-harness-vision run build && pnpm --filter @vascent/deepseek-harness-web run build && pnpm --filter @vascent/deepseek-harness-tui run build && tsdown",
    "lint": "oxlint --deny-warnings src scripts tests tsdown.config.ts && pnpm --filter './packages/*' run lint",
    "typecheck": "tsc --noEmit && pnpm --filter './packages/*' run typecheck",
    "test": "vitest run tests/launcher.test.ts tests/release.test.ts && pnpm --filter './packages/*' run test",
    "check": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev": "pnpm run build && node bin/dscode-dev.js",
    "install:check": "node scripts/check-fresh-install.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "prepack": "pnpm run build",
    "release": "release-it",
    "start": "node bin/dscode.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.7",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-base": "0.1.0-rc.7",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-cordis-host-runner": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-goal": "0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.7",
    "@deepseek-ai/dsh-permission-presets": "0.1.0-rc.7",
    "@deepseek-ai/dsh-plan-mode": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection-cache": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-stats": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-json": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-todo": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-web": "0.1.0-rc.7",
    "@deepseek-ai/dsh-web-search-deepseek": "0.1.0-rc.7",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-tui": "^0.84.2",
    "@vscode/ripgrep": "^1.18.0",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "pnpm": "11.7.0",
    "yaml": "^2.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "oxlint": "1.76.0",
    "release-it": "21.0.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
