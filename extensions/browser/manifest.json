{
  "manifest_version": 3,
  "name": "dscode Browser",
  "version": "0.1.0",
  "description": "Background browser control for dscode. Click the extension to stop browser tasks.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Stop dscode browser tasks"
  }
}
