{
  "name": "@yangeyu/deepseek-harness-tui",
  "version": "0.1.0",
  "description": "Claude Code-inspired terminal client bundle for DeepSeek Harness",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "tui",
    "coding-agent",
    "terminal"
  ],
  "homepage": "https://github.com/Yangeyu/deepseek-harness-tui#readme",
  "bugs": {
    "url": "https://github.com/Yangeyu/deepseek-harness-tui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yangeyu/deepseek-harness-tui.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./memory": {
      "types": "./lib/memory.d.ts",
      "default": "./lib/memory.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings src tests tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-tui": "^0.84.2",
    "@yangeyu/deepseek-harness-memory": "^0.1.0",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-base": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-host-apiproxy": ">=0.1.0-rc.5 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-base": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-apiproxy": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-base": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-code-runtime-worker-thread": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-cordis-host-runner": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-host-apiproxy": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-host-directory-picker-browse": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session-projection-cache": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session-stats": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-storage": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-storage-json": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-token-meter": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.5 <0.2.0",
    "@types/node": "^22.20.0",
    "oxlint": "1.76.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
