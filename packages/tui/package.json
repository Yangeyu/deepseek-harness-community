{
  "name": "@vascent/deepseek-harness-tui",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code-inspired terminal client bundle for DeepSeek Harness",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "tui",
    "coding-agent",
    "terminal"
  ],
  "homepage": "https://github.com/Yangeyu/deepseek-harness-community/tree/main/packages/tui#readme",
  "bugs": {
    "url": "https://github.com/Yangeyu/deepseek-harness-community/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yangeyu/deepseek-harness-community.git",
    "directory": "packages/tui"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./bailian": {
      "types": "./dist/bailian.d.ts",
      "default": "./dist/bailian.js"
    },
    "./vision": {
      "types": "./dist/vision.d.ts",
      "default": "./dist/vision.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings src tests tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
