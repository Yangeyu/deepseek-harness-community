# ==============================================================================
# dscode patch 层示例（本文件是参考模板，不会被加载）
#
# 首次运行放入 $DSH_HOME（默认 ~/.dsh）。模板本身不生效。
# 把需要的条目去掉注释后加入 profiles/<name>/cordis.patch.yml。
#
# 合成优先级：bundle 默认 → profile patch → $DSH_HOME/cordis.patch.yml → --patch。
# 条目通过 id 定位服务；config 整体替换该条目的继承配置，
# 缺失字段使用插件 schema 默认值。手写时应保留仍需使用的已有字段。
# /config、/vision、/web 通过上游 Settings 更新同一个 profile patch，Volatile
# 字段即时生效。直接编辑文件后重启 dscode；社区 profile 不启用文件 HMR。
# 凭证只写环境变量引用名，密钥通过环境变量或 Harness 凭据库提供。
#
# - id: agent-default-model
#   config:
#     provider: bailian
#     model: deepseek-v4-pro-0813
#     reasoningEffort: high
#
# - id: permission
#   config:
#     defaultPreset: workspace-write
#
# - id: community-web
#   config:
#     searchProvider: auto                 # auto | community-tavily | deepseek-official
#     extractProvider: community-tavily
#     tavilyApiKeyEnv: TAVILY_API_KEY
#     tavilySearchDepth: basic
#     tavilyExtractDepth: basic
#     tavilyTimeoutSeconds: 30
#     extractMaxOutputChars: 60000
#
# ────────────────────────────────────────────────────────────────────────
# 附件资源上限（attachment-local 服务）
# ────────────────────────────────────────────────────────────────────────
# 官方默认会准入至单边 8192px / 6400 万像素 / 20 MiB，再归一化为最长边
# 2048px、至多 4 MiB；社区 TUI 不再覆盖这套策略。资源受限机器如需主动
# 收紧，可复制下面的配置：
# - id: attachment-local
#   name: '@deepseek-ai/dsh-attachment-local'
#   config:
#     maxImageDimension: 4096
#     maxImagePixels: 16000000
#     maxImageBytes: 10485760
#     normalizedImageMaxDimension: 1600
#     normalizedImageMaxBytes: 3145728

# ────────────────────────────────────────────────────────────────────────
# 终端外观与行为（terminal 服务）
# ────────────────────────────────────────────────────────────────────────
# - id: terminal
#   config:
#     historyMessages: 200                 # 会话列表保留的历史消息数
#     rewindHistory: 20                    # Rewind 可选历史点数量
#     showReasoning: true                  # 展示推理过程
#     thinkingMaxLines: 8                  # 思考块折叠行数
#     color: true                          # 彩色输出

# ────────────────────────────────────────────────────────────────────────
# Vision 图片路线
# ────────────────────────────────────────────────────────────────────────
# - id: vision
#   config:
#     mode: proxy                          # auto | proxy | disabled
#     proxyProvider: bailian
#     proxyModel: qwen3.7-plus

# ────────────────────────────────────────────────────────────────────────
# 首类 Bailian 模型表
# ────────────────────────────────────────────────────────────────────────
# 下例替换完整模型表，仅保留列出的模型；按需补齐其他模型。
# - id: llm-bailian
#   config:
#     baseURL: https://dashscope.aliyuncs.com/compatible-mode/v1
#     models:
#       deepseek-v4-pro-0813:
#         contextWindow: 1000000
#         maxOutputTokens: 393216
#         maxTokensField: max_tokens
#         input: [text]
#         reasoning:
#           defaultEffort: high
#           efforts:
#             off: { enableThinking: false }
#             low: { enableThinking: true, reasoningEffort: low }
#             high: { enableThinking: true, reasoningEffort: high }
#             max: { enableThinking: true, reasoningEffort: max }

# ────────────────────────────────────────────────────────────────────────
# Browser / Computer Use（实验性；启用后重启）
# ────────────────────────────────────────────────────────────────────────
# 日常 Chrome：先在 chrome://inspect/#remote-debugging 开启调试并允许连接。
# - id: community-browser
#   disabled: false
# 桌面：需宿主辅助功能/屏幕录制权限；截图需当前模型原生支持图片输入。
# - id: computer-use-native
#   disabled: false

# 模板本身是空补丁列表；把上面的条目复制进 cordis.patch.yml 即成为生效配置。
[]
